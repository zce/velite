{
  "name": "velite",
  "version": "1.0.0-alpha.3",
  "description": "Turns Markdown / MDX, YAML, JSON, or other files into app's data layer with type-safe schema.",
  "keywords": [
    "contentlayer",
    "headless-cms",
    "data-layer",
    "creative",
    "content",
    "velite",
    "cli",
    "zce"
  ],
  "repository": "zce/velite",
  "license": "MIT",
  "author": "zce <w@zce.me> (https://zce.me)",
  "type": "module",
  "bin": {
    "velite": "./dist/cli.mjs"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsdown",
    "test": "pnpm build && node --import jiti/register --test 'test/**/*.tests.ts'",
    "test:src": "node --import jiti/register --test 'test/api-contract.tests.ts' 'test/build.tests.ts' 'test/image-build.tests.ts' 'test/incremental.tests.ts' 'test/runtime-neutral.tests.ts' 'test/watch-initial-build.tests.ts' 'test/core/**/*.tests.ts' 'test/runtime/**/*.tests.ts'",
    "bench:large": "pnpm build && node --import jiti/register scripts/bench-large.ts",
    "docs:dev": "cd docs && pnpm dev",
    "docs:build": "cd docs && pnpm build",
    "format": "prettier . --write"
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/cli.ts"
    ],
    "deps": {
      "onlyBundle": false
    },
    "hash": false
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,md}": "prettier --write"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "jiti": "^2.7.0",
    "sharp": "^0.34.5",
    "terser": "^5.44.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@types/picomatch": "^4.0.3",
    "chokidar": "^5.0.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-to-string": "^3.0.1",
    "lint-staged": "^17.0.7",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "picomatch": "^4.0.4",
    "prettier": "^3.8.4",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "simple-git-hooks": "^2.13.1",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^3.0.0-1"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0"
  }
}
